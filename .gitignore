# Dependencies (reinstalled with `npm ci`)
node_modules/

# Build output (regenerated by `npm run build` and by the Pages workflow)
dist/
dist-single/
*.tsbuildinfo
coverage/

# Environment and secrets (the app needs none; ignored as a safeguard)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs and caches
*.log
npm-debug.log*
.npm/
.vite/
.cache/

# Editor and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Stray lockfile outside the app folder
/package-lock.json
